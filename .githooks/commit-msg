#!/bin/sh
#
# Rechaza atribución a herramientas o coautoría en el mensaje de commit.
# Regla S17: el autor y el committer son siempre el dueño del repositorio.
# No hay trailers Co-authored-by, ni firmas de herramientas, ni líneas
# generadas por asistentes.

message_file="$1"

if [ -z "$message_file" ] || [ ! -f "$message_file" ]; then
  echo "commit-msg: no se recibió el archivo de mensaje." >&2
  exit 1
fi

offending=$(grep -inE \
  'co-authored-by|co-authored|coauthor|co-author|generated with|generated by|claude|anthropic|openai|chatgpt|gpt-[0-9]|copilot|cursor agent|codex' \
  "$message_file")

if [ -n "$offending" ]; then
  echo "" >&2
  echo "commit rechazado: el mensaje incluye atribución a una herramienta o coautoría." >&2
  echo "" >&2
  printf '%s\n' "$offending" | sed 's/^/  /' >&2
  echo "" >&2
  echo "Regla S17: el autor es siempre el dueño del repositorio." >&2
  echo "Borra esas líneas del mensaje y volvé a intentar." >&2
  echo "" >&2
  exit 1
fi

exit 0
