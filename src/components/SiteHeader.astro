---
// Sticky top bar: brand and documentation link on the left, search and theme
// toggle on the right. Only routes that exist are linked (S7).
import SiteSearch from './SiteSearch.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  /** Docs pages run full viewport width so the rail and the brand line up. */
  wide?: boolean;
}

const { wide = false } = Astro.props;
---
<header class="site-header">
  <div class:list={['container', 'site-header__inner', wide && 'container--wide']}>
    <a class="brand" href="/">
      <img class="brand__mark" src="/logo.webp" alt="" width="32" height="32" decoding="async" />
      <span class="brand__name">JavaGod</span>
    </a>
    <nav class="site-header__nav" aria-label="Principal">
      <a class="site-header__link" href="/docs/">Documentación</a>
      <SiteSearch />
      <ThemeToggle />
    </nav>
  </div>
</header>
