---
// Sticky top bar: brand and documentation link on the left, theme toggle on the
// right. Only routes that exist are linked (S7).
import ThemeToggle from './ThemeToggle.astro';
---
<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/">
      <span class="brand__mark" aria-hidden="true">J</span>
      <span class="brand__name">JavaGod</span>
    </a>
    <nav class="site-header__nav" aria-label="Principal">
      <a class="site-header__link" href="/docs/">Documentación</a>
      <ThemeToggle />
    </nav>
  </div>
</header>
