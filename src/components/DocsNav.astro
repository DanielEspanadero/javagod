---
// Sidebar tree for the docs layout. It only renders what exists: no section
// without chapters, no link to a route that is not published (S7).
//
// Every entry carries its version range so the reading mode can hide it without
// touching the DOM (S16); the range comes from the frontmatter of the chapter.
import { docHref, type DocGroup } from '../lib/docs';

interface Props {
  groups: DocGroup[];
  /** Chapter id that owns the current page, for the active state. */
  currentId?: string;
}

const { groups, currentId } = Astro.props;
---
<nav class="docs-nav" aria-label="Índice de documentación">
  <ul class="docs-nav__sections">
    {
      groups.map((group) => (
        <li>
          <p class="docs-nav__section-title">{group.section.title}</p>
          <ul class="docs-nav__pages">
            {group.docs.map((doc) => (
              <li data-version-item data-since={doc.data.since} data-hasta={doc.data.hasta}>
                <a
                  class="docs-nav__link"
                  href={docHref(doc)}
                  aria-current={doc.id === currentId ? 'page' : undefined}
                >
                  {doc.data.title}
                </a>
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
</nav>
