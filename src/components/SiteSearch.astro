---
// Static search (S3): the site is read in order but any topic has to be
// reachable directly. Pagefind indexes the built pages and ships its own
// runtime; this component owns the control, the dialog and the result list so
// the search looks like the rest of the site instead of a third-party widget.
//
// Nothing is fetched until the reader opens the dialog, and without JavaScript
// the control is hidden like every other enhancement (S2): the pages still
// carry their own navigation and table of contents.
import '../styles/search.css';
---
<div class="search">
  <button
    class="search-toggle"
    type="button"
    aria-haspopup="dialog"
    aria-controls="site-search"
    data-search-open
  >
    <svg class="search-toggle__icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
      <circle cx="9" cy="9" r="6" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
      <path
        d="M13.5 13.5 17 17"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"></path>
    </svg>
    <span class="search-toggle__label">Buscar</span>
    <kbd class="search-toggle__key" aria-hidden="true">K</kbd>
  </button>
</div>

<dialog class="search-dialog" id="site-search" aria-label="Buscar en JavaGod" data-search-dialog>
  <div class="search-dialog__inner">
    <label class="search-field">
      <span class="search-field__label">Buscar en JavaGod</span>
      <input
        class="search-field__input"
        type="search"
        placeholder="ArrayList, final, hilos..."
        autocomplete="off"
        spellcheck="false"
        aria-controls="search-results"
        aria-describedby="search-keyboard"
        aria-keyshortcuts="ArrowDown Enter"
        data-search-input
      />
    </label>
    <p class="search-hint" data-search-hint>Escribe para buscar en los capítulos.</p>
    <p class="search-hint" id="search-keyboard">Flecha abajo para entrar en los resultados; flechas arriba y abajo para recorrerlos. Intro abre el resultado, Tab permite llegar a Mostrar más y Esc cierra.</p>
    <p class="search-status" role="status" data-search-status hidden></p>
    <ul class="search-results" id="search-results" aria-label="Resultados de búsqueda" data-search-results></ul>
    <button class="search-dialog__more" type="button" aria-controls="search-results" data-search-more hidden>Mostrar más</button>
    <button class="search-dialog__close" type="button" data-search-close>Cerrar <kbd>Esc</kbd></button>
  </div>
</dialog>

<script>
  import { ltsVersions } from '../lib/versions.mjs';

  /** Query wins over storage; an unset mode uses the newest supported LTS. */
  function selectedVersion(): number | 'all' {
    let raw = new URLSearchParams(window.location.search).get('v');
    if (raw === null) {
      try {
        raw = window.localStorage.getItem('javagod:version');
      } catch {
        // Storage is optional, as in VersionSwitcher.
      }
    }
    if (raw === null) return 'all';
    const version = Number(raw);
    return Number.isInteger(version) && ltsVersions.includes(version) ? version : 'all';
  }

  /**
   * Pagefind result, as much of it as the dialog uses.
   *
   * @typedef {object} PagefindEntry
   * @property {string} url
   * @property {string} excerpt
   * @property {{ title?: string, since?: string, hasta?: string }} meta
   */

  /**
   * The Pagefind runtime, loaded on first open. It is generated by
   * `pagefind --site dist`, so it only exists after a build: in `pnpm dev` the
   * import fails and the dialog says so instead of failing silently.
   *
   * @typedef {object} PagefindRuntime
   * @property {(options: { excerptLength?: number }) => Promise<void>} options
   * @property {(query: string) => Promise<{ results: { data(): Promise<PagefindEntry> }[] }>} search
   */

  /** How many filtered results to append at a time. */
  const maxResults = 8;

  const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]');
  const openers = document.querySelectorAll<HTMLElement>('[data-search-open]');
  const input = dialog?.querySelector<HTMLInputElement>('[data-search-input]') ?? null;
  const hint = dialog?.querySelector<HTMLElement>('[data-search-hint]') ?? null;
  const status = dialog?.querySelector<HTMLElement>('[data-search-status]') ?? null;
  const list = dialog?.querySelector<HTMLUListElement>('[data-search-results]') ?? null;
  const close = dialog?.querySelector<HTMLElement>('[data-search-close]') ?? null;
  const more = dialog?.querySelector<HTMLButtonElement>('[data-search-more]') ?? null;

  /** @type {PagefindRuntime | null} */
  let runtime = null;
  /** @type {Promise<PagefindRuntime | null> | null} */
  let loading = null;
  /** Bumped on every query so a slow answer never overwrites a newer one. */
  let queryToken = 0;
  let debounce = 0;
  /** Filtered results from the current query, reused without another search. */
  let available: PagefindEntry[] = [];
  let shown = 0;
  let hiddenNote = '';

  /**
   * Load the runtime once. A failed load is remembered as `null` and reported
   * by the caller, so typing never retries a bundle that is not there.
   *
   * The path goes through a variable on purpose: Vite resolves a literal
   * dynamic import at build time and fails in `pnpm dev`, where the Pagefind
   * bundle does not exist yet. `@vite-ignore` alone is not enough for that.
   */
  async function loadRuntime(): Promise<PagefindRuntime | null> {
    if (runtime) return runtime;
    if (loading) return loading;

    const bundle = '/pagefind/pagefind.js';

    loading = (async () => {
      try {
        const module = await import(/* @vite-ignore */ bundle);

        await module.options({ excerptLength: 18 });
        runtime = module as PagefindRuntime;

        return runtime;
      } catch {
        return null;
      }
    })();

    return loading;
  }

  /** Show one line of status text, or hide the line when there is nothing to say. */
  function setStatus(message: string | null): void {
    if (!status) return;

    status.textContent = message ?? '';
    status.hidden = message === null;
  }

  /** Empty the result list. */
  function clearResults(): void {
    list?.replaceChildren();
    available = [];
    shown = 0;
    hiddenNote = '';
    if (more) more.hidden = true;
  }

  /** Append a page in the original order and keep the announced count honest. */
  function showMore(focusFirst = false): void {
    const rows = available.slice(shown, shown + maxResults).map(renderResult);
    list?.append(...rows);
    shown += rows.length;

    // Hiding the button that holds focus would drop the reader back to the
    // document, outside the dialog. Remember it before the button disappears.
    const keepsFocus = document.activeElement === more;
    if (more) more.hidden = shown >= available.length;

    const count = available.length > shown
      ? `${shown} de ${available.length} resultados`
      : `${shown} ${shown === 1 ? 'resultado' : 'resultados'}`;
    setStatus(`${count}${hiddenNote}`);

    // Native keyboard/AT activation must not leave focus on a hidden button.
    if (focusFirst || (keepsFocus && shown >= available.length)) {
      rows[0]?.querySelector('a')?.focus();
    }
  }

  /**
   * One result row. Text goes in as text and the excerpt as HTML: Pagefind
   * returns the fragment it built itself, with the matched terms wrapped in
   * `<mark>`.
   */
  function renderResult(entry: PagefindEntry): HTMLLIElement {
    const item = document.createElement('li');
    item.className = 'search-result';

    const link = document.createElement('a');
    link.className = 'search-result__link';
    link.href = entry.url;
    link.setAttribute('aria-keyshortcuts', 'ArrowUp ArrowDown');

    const title = document.createElement('span');
    title.className = 'search-result__title';
    title.textContent = entry.meta.title ?? entry.url;

    const excerpt = document.createElement('span');
    excerpt.className = 'search-result__excerpt';
    excerpt.innerHTML = entry.excerpt.trim();

    link.append(title, excerpt);
    item.append(link);

    return item;
  }

  /** Run one query and paint its results. */
  async function runSearch(raw: string): Promise<void> {
    const query = raw.trim();
    const token = ++queryToken;
    clearResults();

    if (query.length === 0) {
      clearResults();
      setStatus(null);
      if (hint) hint.hidden = false;
      return;
    }

    if (hint) hint.hidden = true;
    setStatus('Buscando...');

    const engine = await loadRuntime();

    if (token !== queryToken) return;

    if (!engine) {
      clearResults();
      setStatus('La búsqueda no está disponible todavía: ejecuta `pnpm build` para generar el índice.');
      return;
    }

    const found = await engine.search(query);

    if (token !== queryToken) return;

    // Read every match before limiting: hidden matches must not consume slots,
    // and both the available total and the hidden count must be honest.
    const entries = await Promise.all(found.results.map((result) => result.data()));

    if (token !== queryToken) return;

    clearResults();

    const version = selectedVersion();
    available = entries.filter((entry) => {
      if (version === 'all' || !entry.meta.since) return true;
      return Number(entry.meta.since) <= version &&
        (!entry.meta.hasta || Number(entry.meta.hasta) >= version);
    });
    const hidden = entries.length - available.length;
    hiddenNote =
      hidden === 0
        ? ''
        : `, ${hidden} ${hidden === 1 ? 'oculto' : 'ocultos'} por el modo Java ${version}`;

    if (entries.length === 0) {
      setStatus(`Sin resultados para «${query}».`);
    } else if (available.length === 0) {
      setStatus(`Ningún resultado para «${query}» en el modo Java ${version}${hiddenNote}.`);
    } else {
      showMore();
    }
  }

  /** Debounce the keystrokes so a fast typist runs one query, not eight. */
  function onInput(): void {
    window.clearTimeout(debounce);
    ++queryToken;
    clearResults();
    setStatus('Buscando...');
    if (hint) hint.hidden = true;

    const value = input?.value ?? '';

    debounce = window.setTimeout(() => {
      void runSearch(value);
    }, 140);
  }

  /** Open the dialog and put the cursor where the reader is going to type. */
  async function open(): Promise<void> {
    if (!dialog) return;

    dialog.showModal();
    input?.focus();
    input?.select();

    await runSearch(input?.value ?? '');
  }

  openers.forEach((opener) => opener.addEventListener('click', () => void open()));
  close?.addEventListener('click', () => dialog?.close());
  input?.addEventListener('input', onInput);
  more?.addEventListener('click', (event) => showMore(event.detail === 0));

  // Keep native links and list semantics. Focus, rather than an ARIA-only
  // active descendant, makes the same navigation work for keyboard and AT.
  dialog?.addEventListener('keydown', (event) => {
    /* A `type=search` field eats the first Escape to clear itself, which leaves
       the dialog open and surprises anyone who expects Esc to close. Close on
       the first press instead; the native focus restore still runs. */
    if (event.key === 'Escape') {
      event.preventDefault();
      dialog?.close();
      return;
    }

    const links = [...(list?.querySelectorAll<HTMLAnchorElement>('a') ?? [])];
    const current = links.indexOf(document.activeElement as HTMLAnchorElement);
    if (event.target === input) {
      if (event.key === 'ArrowDown' && links.length > 0) {
        event.preventDefault();
        links[0].focus();
      } else if (event.key === 'Enter') {
        event.preventDefault();
        links[0]?.click();
      }
    } else if (current >= 0 && (event.key === 'ArrowUp' || event.key === 'ArrowDown')) {
      event.preventDefault();
      if (event.key === 'ArrowUp' && current === 0) input?.focus();
      else links[Math.min(links.length - 1, current + (event.key === 'ArrowDown' ? 1 : -1))]?.focus();
    }
  });

  // A click on the backdrop lands on the dialog itself, never on its content.
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });

  dialog?.addEventListener('close', () => {
    window.clearTimeout(debounce);
    ++queryToken;
    clearResults();
    setStatus(null);
    if (hint) hint.hidden = false;
  });

  // Cmd/Ctrl+K is the search shortcut readers already have in their fingers.
  // `/` is taken by the landing terminal, so it is not bound here.
  document.addEventListener('keydown', (event) => {
    if (event.key.toLowerCase() !== 'k' || !(event.metaKey || event.ctrlKey)) return;

    event.preventDefault();

    if (dialog?.open) {
      dialog.close();
    } else {
      void open();
    }
  });
</script>
