---
import BaseLayout from '../layouts/BaseLayout.astro';
import TerminalCard from '../components/TerminalCard.astro';
import JvmPipeline from '../components/JvmPipeline.astro';
import ThreadStates from '../components/ThreadStates.astro';

type PathStep = {
  index: string;
  title: string;
  text: string;
};

const words = ['Aprende', 'Java', 'viendo', 'qué', 'pasa', 'por', 'dentro.'];

const path: PathStep[] = [
  {
    index: '01',
    title: 'Fundamentos',
    text: 'La JVM, los tipos y el control de flujo. Empiezas con un Hola, mundo y ves qué hace javac por ti.',
  },
  {
    index: '02',
    title: 'Orientación a Objetos',
    text: 'Clases, encapsulamiento, herencia e interfaces, con diagramas de memoria que se leen de un vistazo.',
  },
  {
    index: '03',
    title: 'Collections & Streams',
    text: 'Listas, mapas y conjuntos, más el pipeline funcional de Stream: qué colección usar y cuándo.',
  },
  {
    index: '04',
    title: 'Concurrencia',
    text: 'Hilos, estados, locks y memoria compartida. Lo que rompe en producción, explicado igual de claro.',
  },
];
---
<BaseLayout
  title="JavaGod · documentación visual de Java"
  description="Aprende Java viendo qué pasa por dentro: diagramas animados, bytecode paso a paso y la máquina virtual explicada en español. Con marcas de versión para cada cosa, de Java 8 a Java 25."
>
  <section class="hero">
    <div class="hero__spotlight" aria-hidden="true" data-spotlight></div>
    <div class="container hero__inner">
      <div class="hero__copy">
        <p class="hero__eyebrow" style="--i: 0">Documentación visual de Java</p>
        <h1 class="hero__title">
          {
            words.map((word, index) => (
              <>
                <span class="hero__word" style={`--i: ${index + 1}`}>
                  {word === 'Java' ? <span class="hero__accent">{word}</span> : word}
                </span>{' '}
              </>
            ))
          }
        </h1>
        <p class="hero__lead" style="--i: 6">
          Diagramas animados, bytecode paso a paso y la máquina virtual explicada sin humo. Todo lo
          que ocurre entre tu código y la salida.
        </p>
        <div class="hero__actions" style="--i: 7">
          <a class="btn btn--primary" href="#camino">Empezar por los fundamentos</a>
          <a class="btn btn--ghost" href="#visualizaciones">Ver visualizaciones</a>
        </div>
        <p class="hero__meta" style="--i: 8">De Java 8 a Java 25 · En español</p>
      </div>

      <div class="hero__visual" style="--i: 8">
        <TerminalCard />
      </div>
    </div>
  </section>

  <aside class="stance" aria-label="Cómo es este sitio">
    <div class="container">
      <ul class="stance__list">
        <li class="stance__item">Sin anuncios</li>
        <li class="stance__item">Sin registro</li>
        <li class="stance__item">Sin cuentas</li>
        <li class="stance__item">De Java 8 a Java 25</li>
      </ul>
    </div>
  </aside>

  <section class="section section--soft" id="ruta">
    <div class="container">
      <div class="section__head" data-reveal>
        <p class="section__eyebrow">La ruta</p>
        <h2 class="section__title">Del código a la pantalla, sin cajas negras</h2>
        <p class="section__lead">
          Cinco etapas. La misma ruta que sigue tu programa cada vez que ejecutas java.
        </p>
        <p class="section__note" data-reveal>
          Abre una etapa para ver el detalle. También funciona con Enter.
        </p>
      </div>
      <JvmPipeline />
    </div>
  </section>

  <section class="section" id="camino">
    <div class="container">
      <div class="section__head" data-reveal>
        <p class="section__eyebrow">El camino</p>
        <h2 class="section__title">Un recorrido progresivo, de cero a concurrencia</h2>
        <p class="section__lead">
          Cada etapa se apoya en la anterior. Puedes leerlo de corrido o ir directo a lo que
          necesitas hoy.
        </p>
      </div>

      <ol class="path__list">
        {
          path.map((step, index) => (
            <li class="path__item" data-reveal data-path-item style={`--i: ${index + 1}`}>
              <span class="path__rail" aria-hidden="true">
                <span class="path__rail-fill" />
              </span>
              <span class="path__index" aria-hidden="true">{step.index}</span>
              <div class="path__body">
                <h3 class="path__title">{step.title}</h3>
                <p class="path__text">{step.text}</p>
                <span class="chip chip--soon">En preparación</span>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--soft" id="visualizaciones">
    <div class="container">
      <div class="section__head" data-reveal>
        <p class="section__eyebrow">Visualizaciones</p>
        <h2 class="section__title">Los estados de un hilo, paso a paso</h2>
        <p class="section__lead">
          El ciclo de vida de un Thread. El diagrama se entiende completo sin
          JavaScript; con los controles puedes probar cada transición y ver cuáles acepta la
          máquina virtual.
        </p>
      </div>
      <div class="showcase" data-reveal style="--i: 1">
        <ThreadStates />
      </div>
    </div>
  </section>

  <section class="closing">
    <div class="container closing__inner" data-reveal>
      <h2 class="closing__title">Todo Java, explicado como se ve.</h2>
      <p class="closing__lead">
        Sin anuncios, sin registro y sin cookies. Un sitio estático generado en el build, sin
        backend ni base de datos.
      </p>
      <ul class="closing__principles">
        <li class="closing__principle">Estático</li>
        <li class="closing__principle">Sin cookies</li>
        <li class="closing__principle">Sin cuentas</li>
      </ul>
      <a class="btn btn--primary closing__cta" href="#camino">Empezar por los fundamentos</a>
    </div>
  </section>
</BaseLayout>
