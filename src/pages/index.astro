---
import BaseLayout from '../layouts/BaseLayout.astro';
import TerminalCard from '../components/TerminalCard.astro';
import JvmPipeline from '../components/JvmPipeline.astro';
import ThreadStates from '../components/ThreadStates.astro';
import { findSection } from '../lib/sections.mjs';
import { docHref, getDocs, groupDocs } from '../lib/docs';

type PathStep = {
  /** Section id from the registry: the title is never repeated here (S9). */
  id: string;
  text: string;
};

const words = ['Aprende', 'Java', 'viendo', 'qué', 'pasa', 'por', 'dentro.'];

/**
 * Chapters published per section. The landing never claims a section is ready
 * on its own: the count comes from the content collection, so a section with
 * chapters links to them and the rest stay honestly marked as in preparation
 * (S7). It also keeps the landing from drifting from what docs actually has.
 */
const docs = await getDocs();
const groups = groupDocs(docs);
const chaptersPerSection = new Map(groups.map((group) => [group.section.id, group.docs.length]));
const contentGroups = groups.filter((group) => group.section.id !== 'novedades');
const chapterCount = contentGroups.reduce((count, group) => count + group.docs.length, 0);
const confirmedVersions = docs.map((doc) => doc.data.since);
const versionRange = confirmedVersions.length > 0
  ? `De Java ${Math.min(...confirmedVersions)} a Java ${Math.max(...confirmedVersions)}`
  : undefined;

// Literal excerpt from DecimalScale.java and the first three lines of its output.
const sampleChapter = docs.find((doc) => doc.id === 'biblioteca/bigdecimal');
const sampleCode = `BigDecimal price = new BigDecimal("19.90");
System.out.println(price.unscaledValue());
System.out.println(price.scale());
System.out.println(price.precision());`;
const sampleOutput = `1990
2
4`;
const readingFragment = 'public record Punto(int x, int y) {}';

const path: PathStep[] = [
  {
    id: 'fundamentos',
    text: 'La JVM, los tipos y el control de flujo. Empiezas con un Hola, mundo y ves qué hace javac por ti.',
  },
  {
    id: 'objetos',
    text: 'Clases, encapsulamiento, herencia e interfaces, con diagramas de memoria que se leen de un vistazo.',
  },
  {
    id: 'colecciones',
    text: 'Listas, mapas y conjuntos, más el pipeline funcional de Stream: qué colección usar y cuándo.',
  },
  {
    id: 'concurrencia',
    text: 'Hilos, estados, locks y memoria compartida. Lo que rompe en producción, explicado igual de claro.',
  },
  {
    id: 'biblioteca',
    text: 'Fechas, zonas horarias, dinero exacto y archivos: la biblioteca estándar que se toca todos los días.',
  },
  {
    id: 'calidad',
    text: 'Comprobaciones que dicen la verdad: qué asertar, cómo aislar el mundo exterior y cómo se escribe un test con JUnit 5.',
  },
];
---
<BaseLayout
  title="JavaGod · documentación visual de Java"
  description="Aprende Java viendo qué pasa por dentro: diagramas animados, bytecode paso a paso y la máquina virtual explicada en español. Con marcas de versión para cada cosa, de Java 8 a Java 25."
>
  <section class="hero">
    <div class="hero__spotlight" aria-hidden="true" data-spotlight></div>
    <div class="container hero__inner">
      <div class="hero__copy">
        <p class="hero__eyebrow" style="--i: 0">Documentación visual de Java</p>
        <h1 class="hero__title">
          {
            words.map((word, index) => (
              <>
                <span class="hero__word" style={`--i: ${index + 1}`}>
                  {word === 'Java' ? <span class="hero__accent">{word}</span> : word}
                </span>{' '}
              </>
            ))
          }
        </h1>
        <p class="hero__lead" style="--i: 6">
          Diagramas animados, bytecode paso a paso y la máquina virtual explicada sin humo. Todo lo
          que ocurre entre tu código y la salida.
        </p>
        <div class="hero__actions" style="--i: 7">
          <a class="btn btn--primary" href="/docs/">Empezar por los fundamentos</a>
          <a class="btn btn--ghost" href="#visualizaciones">Ver visualizaciones</a>
        </div>
        <ul class="proof" aria-label="Contenido publicado">
          {chapterCount > 0 && <li class="chip">{chapterCount} capítulos</li>}
          {contentGroups.length > 0 && <li class="chip">{contentGroups.length} secciones de contenido</li>}
          {versionRange && <li class="chip">{versionRange}</li>}
        </ul>
      </div>

      <div class="hero__visual" style="--i: 8">
        <TerminalCard />
      </div>
    </div>
  </section>

  <aside class="stance" aria-label="Cómo es este sitio">
    <div class="container">
      <ul class="stance__list">
        <li class="stance__item">Sin anuncios</li>
        <li class="stance__item">Sin registro</li>
        <li class="stance__item">Sin cuentas</li>
        <li class="stance__item">En español</li>
      </ul>
    </div>
  </aside>

  <section class="section section--soft" id="ruta">
    <div class="container">
      <div class="section__head" data-reveal>
        <p class="section__eyebrow">La ruta</p>
        <h2 class="section__title">Del código a la pantalla, sin cajas negras</h2>
        <p class="section__lead">
          Cinco etapas. La misma ruta que sigue tu programa cada vez que ejecutas java.
        </p>
        <p class="section__note" data-reveal>
          Abre una etapa para ver el detalle. También funciona con Enter.
        </p>
      </div>
      <JvmPipeline />
    </div>
  </section>

  <section class="section" id="camino">
    <div class="container">
      <div class="section__head" data-reveal>
        <p class="section__eyebrow">El camino</p>
        <h2 class="section__title">
          Un recorrido progresivo en {path.length} etapas: del Hola, mundo al código que se
          sostiene
        </h2>
        <p class="section__lead">
          Cada etapa se apoya en la anterior. Puedes leerlo de corrido o ir directo a lo que
          necesitas hoy.
        </p>
      </div>

      <ol class="path__list">
        {
          path.map((step, index) => (
            <li class="path__item" data-reveal data-path-item style={`--i: ${index + 1}`}>
              <span class="path__rail" aria-hidden="true">
                <span class="path__rail-fill" />
              </span>
              <span class="path__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <div class="path__body">
                <h3 class="path__title">{findSection(step.id)?.title}</h3>
                <p class="path__text">{step.text}</p>
                {
                  (chaptersPerSection.get(step.id) ?? 0) > 0 ? (
                    <a class="chip chip--ready" href={`/docs/#${step.id}`}>
                      {(chaptersPerSection.get(step.id) ?? 0) === 1
                        ? '1 capítulo'
                        : `${chaptersPerSection.get(step.id)} capítulos`}
                    </a>
                  ) : (
                    <span class="chip chip--soon">En preparación</span>
                  )
                }
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--soft" id="modo-de-lectura" aria-labelledby="lectura-title">
    <div class="container">
      <div class="section__head" data-reveal>
        <p class="section__eyebrow">Modo de lectura</p>
        <h2 class="section__title" id="lectura-title">Tu versión, sin perder el contexto</h2>
        <p class="section__lead">
          El selector oculta del índice y la navegación lo que aún no existía en tu LTS.
          Si abres un capítulo más reciente por su enlace directo, te avisa en vez de borrarlo.
          Una página por tema, sin duplicar URLs; el parámetro <code>?v=</code> comparte tu modo.
        </p>
      </div>
      <div class="reading-example" data-reveal>
        <section class="showcase reading-example__panel" aria-labelledby="lectura-8">
          <h3 class="path__title" id="lectura-8">Java 8</h3>
          <p class="chip">Fuera de esta versión</p>
          <pre class="chapter-fragment"><code>{readingFragment}</code></pre>
          <p class="path__text">
            Records no aparece en el índice. Si llegas al capítulo por un enlace, verás un aviso:
            necesita Java 17, la primera LTS con records.
          </p>
        </section>
        <section class="showcase reading-example__panel" aria-labelledby="lectura-17">
          <h3 class="path__title" id="lectura-17">Java 17</h3>
          <p class="chip">Disponible en esta versión</p>
          <pre class="chapter-fragment"><code>{readingFragment}</code></pre>
          <p class="path__text">
            El mismo capítulo aparece en el índice y puedes leerlo sin aviso de incompatibilidad.
            El código y la ruta son los mismos.
          </p>
        </section>
      </div>
      <p class="section__note">Comparación ilustrada, no otro selector. Las novedades dentro de un capítulo llevan su versión indicada.</p>
      <a class="btn btn--ghost section__action" href="/docs/">Elige tu LTS en la documentación</a>
    </div>
  </section>

  {sampleChapter && (
    <section class="section" id="muestra" aria-labelledby="muestra-title">
      <div class="container">
        <div class="section__head" data-reveal>
          <p class="section__eyebrow">Una muestra real</p>
          <h2 class="section__title" id="muestra-title">Así se ve un capítulo</h2>
          <p class="section__lead">
            ¿Qué guarda un BigDecimal? Este fragmento del ejemplo DecimalScale te enseña
            el entero sin escala, la escala y la precisión, en ese orden.
          </p>
        </div>
        <div class="showcase chapter-sample" data-reveal>
          <div>
            <h3 class="path__title">Código Java</h3>
            <p class="path__text">Fragmento del método main, con java.math.BigDecimal importado.</p>
            <pre class="chapter-fragment"><code>{sampleCode}</code></pre>
          </div>
          <div>
            <h3 class="path__title">Salida</h3>
            <p class="path__text">Las tres primeras líneas de la salida publicada.</p>
            <pre class="chapter-fragment"><samp>{sampleOutput}</samp></pre>
          </div>
        </div>
        <p class="section__note">
          19.90 se representa como 1990 multiplicado por diez elevado a menos 2.
          Tiene cuatro dígitos de precisión, no dos.
        </p>
        <a class="btn btn--primary section__action" href={docHref(sampleChapter)}>Lee el capítulo de BigDecimal</a>
      </div>
    </section>
  )}

  <section class="section section--soft" id="visualizaciones">
    <div class="container">
      <div class="section__head" data-reveal>
        <p class="section__eyebrow">Visualizaciones</p>
        <h2 class="section__title">Los estados de un hilo, paso a paso</h2>
        <p class="section__lead">
          El ciclo de vida de un Thread. El diagrama se entiende completo sin
          JavaScript; con los controles puedes probar cada transición y ver cuáles acepta la
          máquina virtual.
        </p>
      </div>
      <div class="showcase" data-reveal style="--i: 1">
        <ThreadStates />
      </div>
    </div>
  </section>

  <section class="closing">
    <div class="container closing__inner" data-reveal>
      <h2 class="closing__title">Tu siguiente paso: un capítulo.</h2>
      <p class="closing__lead">
        Abre el índice, elige tu versión y empieza por Hola, mundo. Si ya tienes una duda concreta,
        busca el tema y ve directo a su explicación.
      </p>
      <p class="closing__lead">
        Con JavaScript, abre la búsqueda con <kbd>Ctrl + K</kbd> o <kbd>⌘ + K</kbd>.
        En esta portada, <kbd>/</kbd> enfoca el terminal cuando está listo y no estás escribiendo en otro campo.
      </p>
      <a class="btn btn--primary closing__cta" href="/docs/">Elige qué leer hoy</a>
    </div>
  </section>
</BaseLayout>
