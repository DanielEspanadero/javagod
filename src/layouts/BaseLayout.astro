---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/landing.css';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    {
      /*
       * Pre-paint theme: resolve the stored choice (or the system preference)
       * before anything renders, so there is no flash. `js` also lets CSS know
       * that interactive enhancements can be shown.
       */
    }
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        var stored = null;
        try {
          stored = window.localStorage.getItem('javagod:theme');
        } catch (error) {
          stored = null;
        }
        var theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        root.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <SiteHeader />
    <main class="site-main" id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container site-footer__inner">
        <p class="site-footer__note">
          JavaGod · documentación visual de Java en español. Los capítulos están en
          preparación; por ahora, la portada y los diagramas.
        </p>
        <p class="site-footer__meta">Java 21 LTS · Hecho con ☕</p>
      </div>
    </footer>

    {
      /*
       * One controller for the whole page (S14): scroll reveals, the
       * progressive rail and the hero pointer spotlight. It only toggles
       * classes and custom properties; all motion lives in CSS. With reduced
       * motion we settle every target immediately and never create an
       * observer, so nothing depends on the animation layer.
       */
    }
    <script>
      const targets = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      const settle = (element: Element) => {
        element.classList.add('is-visible');
        if (element.hasAttribute('data-path-item')) {
          element.classList.add('is-reached');
        }
      };

      if (targets.length > 0) {
        if (reducedMotion.matches || !('IntersectionObserver' in window)) {
          targets.forEach(settle);
        } else {
          const observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                settle(entry.target);
                observer.unobserve(entry.target);
              }
            },
            { threshold: 0.15, rootMargin: '0px 0px -10% 0px' },
          );

          targets.forEach((target) => observer.observe(target));
        }
      }

      /*
       * Ambient depth for the hero: a soft glow that follows a fine pointer.
       * Coordinates arrive as CSS custom properties, throttled to one write per
       * animation frame. Coarse pointers and reduced motion never start it.
       */
      const spotlight = document.querySelector<HTMLElement>('[data-spotlight]');
      const finePointer = window.matchMedia('(pointer: fine)');

      if (spotlight) {
        let frame = 0;
        let queued: PointerEvent | null = null;

        const paint = () => {
          frame = 0;
          if (!queued) return;

          const bounds = spotlight.getBoundingClientRect();
          spotlight.style.setProperty('--pointer-x', `${queued.clientX - bounds.left}px`);
          spotlight.style.setProperty('--pointer-y', `${queued.clientY - bounds.top}px`);
          spotlight.classList.add('is-lit');
          queued = null;
        };

        window.addEventListener(
          'pointermove',
          (event) => {
            if (!finePointer.matches || reducedMotion.matches) return;
            queued = event;
            if (!frame) frame = window.requestAnimationFrame(paint);
          },
          { passive: true },
        );

        spotlight.parentElement?.addEventListener('pointerleave', () => {
          spotlight.classList.remove('is-lit');
        });
      }
    </script>
  </body>
</html>
