---
// Documentation shell (S5): sidebar tree, breadcrumbs, prose column, in-page
// table of contents and previous/next pager. Everything is derived from the
// content collection, so the layout never needs editing to add a chapter.
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import DocsNav from '../components/DocsNav.astro';
import DocsToc from '../components/DocsToc.astro';
import VersionSwitcher from '../components/VersionSwitcher.astro';
import { docHref, getDocs, getNeighbours, groupDocs, sectionOf } from '../lib/docs';
import { versionLabel } from '../lib/versions.mjs';
import '../styles/docs.css';
import '../styles/diagram.css';

interface Props {
  /** Chapter id, used to locate the page inside the reading order. */
  id: string;
  title: string;
  description: string;
  /** First LTS release in which the chapter reads whole, from the frontmatter (S11). */
  since: number;
  /** Last LTS release the chapter is still valid for, when declared (S11). */
  hasta?: number;
  headings: MarkdownHeading[];
}

const { id, title, description, since, hasta, headings } = Astro.props;

const docs = await getDocs();
const groups = groupDocs(docs);
const { previous, next } = getNeighbours(docs, id);
const current = docs.find((doc) => doc.id === id);
const section = current ? sectionOf(current) : undefined;
const sectionAnchor = section ? `/docs/#${section.id}` : '/docs/';

// One line under the lead. The range is written with "hasta": a dash would
// trip the punctuation rule, and the words read better in Spanish anyway.
const versionLine =
  hasta === undefined
    ? `Desde ${versionLabel(since)}`
    : `Desde ${versionLabel(since)} hasta ${versionLabel(hasta)}`;

// Same range, phrased for the reading mode notice: "cubre Java 8" reads better
// than the chip's "Desde Java 8", and a range needs the "de ... a ..." form.
const chapterRange =
  hasta === undefined
    ? versionLabel(since)
    : `de ${versionLabel(since)} a ${versionLabel(hasta)}`;
---
<BaseLayout title={`${title} · JavaGod`} description={description} wide>
  <div class="docs">
    <aside class="docs__sidebar">
      <VersionSwitcher />
      <DocsNav groups={groups} currentId={id} />
    </aside>

    {
      /*
       * Search indexing (S3): this article is the only part of the site that
       * belongs in the index, so `data-pagefind-body` marks it and every piece
       * of chrome around the prose is ignored. The h1 names the result instead
       * of the whole document title.
       */
    }
    <article
      class="docs__article"
      data-version-page
      data-since={since}
      data-hasta={hasta}
      data-pagefind-body
    >
      <nav class="breadcrumbs" aria-label="Ruta de navegación" data-pagefind-ignore>
        <ol class="breadcrumbs__list">
          <li class="breadcrumbs__item"><a class="breadcrumbs__link" href="/">Inicio</a></li>
          <li class="breadcrumbs__item">
            <a class="breadcrumbs__link" href="/docs/">Documentación</a>
          </li>
          {
            section && (
              <li class="breadcrumbs__item">
                <a class="breadcrumbs__link" href={sectionAnchor}>
                  {section.title}
                </a>
              </li>
            )
          }
          <li class="breadcrumbs__item breadcrumbs__item--current" aria-current="page">{title}</li>
        </ol>
      </nav>

      <header class="docs__header">
        {section && <p class="docs__eyebrow">{section.title}</p>}
        <h1 class="docs__title" data-pagefind-meta="title">{title}</h1>
        <p class="docs__lead">{description}</p>
        <p class="docs__version">{versionLine}</p>
      </header>

      {
        /*
         * Reading mode notice (S16). Rendered hidden and revealed by the
         * script only when the selected version excludes this chapter, so a
         * reader without JavaScript never sees a notice about a filter that is
         * not applied. The selected version is filled in by the script from
         * what the reader actually chose.
         */
      }
      <div class="version-notice" data-version-notice role="status" hidden data-pagefind-ignore>
        <p class="version-notice__text">
          Este capítulo cubre {chapterRange}. Estás leyendo en{' '}
          <span data-version-selected></span>.
        </p>
        <button class="version-notice__action" type="button" data-version-action>
          Cambiar de versión
        </button>
      </div>

      <div class="prose">
        <slot />
      </div>

      {
        (previous || next) && (
          <nav class="pager" aria-label="Capítulos contiguos" data-version-pager data-pagefind-ignore>
            {previous && (
              <a
                class="pager__link pager__link--previous"
                href={docHref(previous)}
                data-version-item
                data-since={previous.data.since}
                data-hasta={previous.data.hasta}
              >
                <span class="pager__direction">Anterior</span>
                <span class="pager__title">{previous.data.title}</span>
              </a>
            )}
            {next && (
              <a
                class="pager__link pager__link--next"
                href={docHref(next)}
                data-version-item
                data-since={next.data.since}
                data-hasta={next.data.hasta}
              >
                <span class="pager__direction">Siguiente</span>
                <span class="pager__title">{next.data.title}</span>
              </a>
            )}
          </nav>
        )
      }
    </article>

    <aside class="docs__toc">
      <DocsToc headings={headings} />
    </aside>
  </div>
</BaseLayout>

{
  /*
   * Copy control for code blocks (S4). The block, its language label and the
   * button are server-rendered; this only wires the click, so the page is
   * complete and readable without it.
   */
}
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.code-block__copy');

  for (const button of buttons) {
    button.addEventListener('click', async () => {
      const code = button.closest('.code-block')?.querySelector('pre');
      if (!code) return;

      try {
        await navigator.clipboard.writeText(code.textContent ?? '');
        button.textContent = 'Copiado';
        button.dataset.copied = 'true';
      } catch {
        button.textContent = 'No se pudo copiar';
      }

      window.setTimeout(() => {
        button.textContent = 'Copiar';
        delete button.dataset.copied;
      }, 1800);
    });
  }
</script>
